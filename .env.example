# Copy this file to .env.local and adjust values.

# Secret used to sign the session cookies. REQUIRED in production —
# generate one with: openssl rand -hex 32
SESSION_SECRET=replace-me-with-a-random-secret

# Admin account used by pnpm db:seed
ADMIN_USERNAME=admin
ADMIN_PASSWORD=avent2026

# Where the SQLite database and uploads live (volume on Coolify).
# DATA_DIR=/data

# Public base URL encoded in the printed QR codes (e.g. https://avent.chezmoi.fr).
# When unset, the QR codes use the requesting host — handy in dev on the LAN.
# NEXT_PUBLIC_APP_URL=https://avent.example.com
