# Advent Blanket — environment template. Copy to .env for local dev.
# In Coolify, set these directly as environment variables of the app.

# REQUIRED in production: secret used to sign the session JWT
# (generate one with: openssl rand -hex 32)
SESSION_SECRET=replace-me-with-a-random-secret

# Backoffice admin account, created on first boot (idempotent seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Where the SQLite database lives — /data inside the container (volume)
#DATA_DIR=/data

# Canonical public URL (https://avent.chezmoi.fr style), no trailing slash —
# used as the base of the QR codes in the printable PDF (falls back to the
# request host when unset)
NEXT_PUBLIC_APP_URL=

# Optional backup tuning (scripts/backup.mjs)
#BACKUP_DIR=/data/backups
#BACKUP_KEEP=14
